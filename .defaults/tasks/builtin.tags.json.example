  "florence_operation": "prompt_gen_tags",
  "instructions": "Output only unique, comma-separated tags for visible subjects, appearance, clothing, action, overall pose, interactions, camera angle, setting, colors and lighting. Use precise, natural terms. Omit uncertain or unshown details. No sentences, headings or commentary.\n\nDescribe supported anatomy and sexual activity directly, using terms such as breasts, nipples, vulva or penis where applicable. Do not infer nudity beneath clothing. Keep the task's requested format and detail.",
  "template": "",
  "internal": false,
  "enabled": true
