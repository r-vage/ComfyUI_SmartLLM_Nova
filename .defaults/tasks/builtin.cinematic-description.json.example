{
  "version": 2,
  "id": "builtin.cinematic-description",
  "name": "Cinematic Description",
  "description": "One cinematic paragraph emphasizing framing, lighting and composition.",
  "group": "image",
  "nodes": [
    "loader"
  ],
  "aliases": [
    "cinematic_description"
  ],
  "input": {
    "text": "optional",
    "images": "required",
